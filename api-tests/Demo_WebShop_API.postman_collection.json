{
  "info": {
    "_postman_id": "8f47c2a1-6d7e-4d4f-9b31-202611200001",
    "name": "Demo WebShop API Testing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET All Users",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/users",
          "protocol": "https",
          "host": [
            "jsonplaceholder",
            "typicode",
            "com"
          ],
          "path": [
            "users"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const users = pm.response.json();",
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Users list is not empty', function () { pm.expect(users).to.be.an('array').that.is.not.empty; });",
              "pm.test('Each user has id, name and email', function () {",
              "  users.forEach(user => {",
              "    pm.expect(user).to.have.property('id');",
              "    pm.expect(user).to.have.property('name');",
              "    pm.expect(user).to.have.property('email');",
              "  });",
              "});",
              "pm.collectionVariables.set('userId', users[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET Single User",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/users/{{userId}}",
          "protocol": "https",
          "host": [
            "jsonplaceholder",
            "typicode",
            "com"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const user = pm.response.json();",
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('User ID matches selected ID', function () { pm.expect(user.id).to.eql(Number(pm.collectionVariables.get('userId'))); });",
              "pm.test('User name is not empty', function () { pm.expect(user.name).to.be.a('string').and.not.empty; });",
              "pm.test('User email is not empty', function () { pm.expect(user.email).to.be.a('string').and.not.empty; });"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT Update User",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Test User\",\n  \"email\": \"updateduser@example.com\",\n  \"phone\": \"01712345678\",\n  \"company\": {\n    \"name\": \"Updated Test Company\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/users/{{userId}}",
          "protocol": "https",
          "host": [
            "jsonplaceholder",
            "typicode",
            "com"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const updatedUser = pm.response.json();",
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('User ID remains unchanged', function () { pm.expect(updatedUser.id).to.eql(Number(pm.collectionVariables.get('userId'))); });",
              "pm.test('Phone number is not empty', function () { pm.expect(updatedUser.phone).to.be.a('string').and.not.empty; });",
              "pm.test('Updated name matches', function () { pm.expect(updatedUser.name).to.eql('Updated Test User'); });"
            ]
          }
        }
      ]
    }
  ]
}